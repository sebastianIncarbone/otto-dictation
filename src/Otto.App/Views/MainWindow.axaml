<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Otto.App.ViewModels"
        xmlns:views="using:Otto.App.Views"
        x:Class="Otto.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Otto"
        Width="560" Height="700"
        MinWidth="420" MinHeight="420"
        Background="{DynamicResource OttoPage}"
        FontFamily="{DynamicResource OttoFontUi}"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- El logotipo, en Archivo expandida peso 800 como pide el diseño. El peso vive
         en el archivo de fuente, no en FontWeight: la cara ya es ExtraBold y pedirle
         negrita encima la sintetizaría una segunda vez. -->
    <Style Selector="TextBlock.wordmark">
      <Setter Property="FontFamily" Value="{DynamicResource OttoFontDisplay}" />
      <Setter Property="FontSize" Value="26" />
      <Setter Property="LineHeight" Value="26" />
      <Setter Property="Foreground" Value="{DynamicResource OttoText}" />
    </Style>

    <!-- El renglón de estado. El color y el peso viven acá y no en el elemento
         porque un valor local le gana a un setter de estilo: puesto inline, el
         apagado del estado inactivo pisaría al de escuchando y nunca cambiaría. -->
    <Style Selector="TextBlock.status">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource OttoTextMuted}" />
    </Style>
    <Style Selector="TextBlock.status.listening">
      <Setter Property="Foreground" Value="{DynamicResource OttoStatusListening}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.status.working">
      <Setter Property="Foreground" Value="{DynamicResource OttoStatusWorking}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LetterSpacing" Value="1" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- El "3 NOTAS" arriba de una lista filtrada. Separado del eyebrow porque el
         diseño los distingue: un rótulo de sección abre más las letras que un
         recuento, que acompaña a la lista en vez de anunciarla. -->
    <Style Selector="TextBlock.count">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LetterSpacing" Value="0.7" />
      <Setter Property="Foreground" Value="{DynamicResource OttoTextMuted}" />
    </Style>

    <!-- El renglón grande del vacío. Chico por defecto: una búsqueda sin
         resultados y un atajo que no se registró son frases que se leen, y en
         cuerpo de titular gritan algo que no da para gritar.

         Sólo el "todavía no dictaste nada" sube a 22 en la cara expandida, porque
         ese sí es un encabezado: es lo único que hay en pantalla y lo que la
         pantalla entera está diciendo. -->
    <Style Selector="TextBlock.empty-heading">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource OttoText}" />
    </Style>
    <Style Selector="TextBlock.empty-heading.invitation">
      <Setter Property="FontFamily" Value="{DynamicResource OttoFontDisplay}" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="LineHeight" Value="26" />
    </Style>

    <!-- El buscador se queda con el borde de acento mientras hay algo escrito, no
         sólo mientras tiene el foco. Una lista filtrada es idéntica a una lista
         corta, y esta es la única marca en pantalla de que no las estás viendo
         todas. -->
    <Style Selector="TextBox.filtering /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource OttoAccent}" />
    </Style>

    <!-- Una nota es un renglón de una lista, no una tarjeta.

         El diseño las separa con una regla de 2px y nada más: sin fondo propio,
         sin borde alrededor, sin sombra. Una tarjeta anuncia que su contenido es
         una unidad aparte, y treinta notas seguidas no son treinta cosas aparte
         — son una lista, y leerla de arriba a abajo es lo único que se hace acá.

         La regla es de 2px sobre el borde al 10%, que es exactamente lo que pide
         el diseño. La probé en 1px porque me pareció que 2px de negro al 10% se
         veía blando, y me equivoqué: es un divisor ancho y suave a propósito, y
         en 1px la lista se endurece. -->
    <Style Selector="Border.note">
      <Setter Property="Padding" Value="20,14" />
      <Setter Property="BorderBrush" Value="{DynamicResource OttoBorder}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>

    <!-- La nota abierta se tiñe con el acento apenas insinuado. Es lo único que
         distingue "estoy escribiendo acá" del resto de la lista, ahora que la
         fila no tiene ni borde ni elevación con los que hacerlo. -->
    <Style Selector="Border.note.editing">
      <Setter Property="Background" Value="{DynamicResource OttoAccentWash}" />
    </Style>

    <!-- La fila elegida va más fuerte que la que se está editando, y el diseño las
         separa a propósito: editar es algo que le pasa a una nota sola y se ve por
         la forma del renglón, mientras que elegir es algo que le pasa a varias y
         sólo se ve por el color. Definida después para que gane si alguna vez
         llegaran a coincidir. -->
    <Style Selector="Border.note.picked">
      <Setter Property="Background" Value="{DynamicResource OttoAccentSoft}" />
    </Style>

    <!-- La casilla: un cuadrado, no un círculo ni el CheckBox de Fluent. Cuadrada
         porque elige varias cosas, y dibujada acá porque el control del sistema
         trae su propio tamaño, su propio radio y su propia animación, ninguno de
         los cuales es el del diseño. -->
    <Style Selector="Border.tick">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,2,12,0" />
      <Setter Property="Background" Value="{DynamicResource OttoSunken}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OttoBorder}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="Border.tick.on">
      <Setter Property="Background" Value="{DynamicResource OttoAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OttoAccent}" />
    </Style>

    <!-- El bloque de lectura entero es el botón que abre la edición: no hay un
         "Editar" en el diseño, y agregarlo sería un botón por nota para algo que
         el texto ya invita a hacer. Plano en todos sus estados salvo el sutil
         aviso de que se puede tocar. -->
    <Style Selector="Button.note-open">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.note-open /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.note-open:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.note-open:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TextBlock.note-title">
      <Setter Property="FontFamily" Value="{DynamicResource OttoFontDisplay}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource OttoText}" />
    </Style>

    <!-- "Sin título" es un relleno, no un título, y se apaga para decirlo. Va por
         HasTitle y no por comparar el texto: alguien puede llamar así a una nota. -->
    <Style Selector="TextBlock.note-title.untitled">
      <Setter Property="Foreground" Value="{DynamicResource OttoTextMuted}" />
    </Style>

    <!-- Fecha, aplicación y duración en monoespaciada: son tres datos que se
         repiten renglón a renglón, y en una fuente de ancho fijo las columnas se
         alinean solas sin que nadie las alinee. -->
    <Style Selector="TextBlock.note-meta">
      <Setter Property="FontFamily" Value="{DynamicResource OttoFontMono}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource OttoTextMuted}" />
    </Style>

    <!-- La familia va explícita: el bloque de lectura es un Button, y el estilo
         base de Button pide la cara SemiBold. Sin esto el cuerpo de cada nota la
         hereda y la lista entera queda en negrita — que es exactamente lo que
         pasó la primera vez que la miré. -->
    <Style Selector="TextBlock.note-body">
      <Setter Property="FontFamily" Value="{DynamicResource OttoFontUi}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="19.5" />
      <Setter Property="Foreground" Value="{DynamicResource OttoText}" />
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">

    <!-- Encabezado: estado siempre visible, porque es lo primero que se pregunta
         cualquiera que abre una app que corre en segundo plano.

         La figura de estado es la misma que dibuja el ícono de bandeja — ver
         StateShapes. Que sea la misma en los dos lados es lo que permite leer el
         estado sin traducir entre dos vocabularios distintos. -->
    <Border DockPanel.Dock="Top" Padding="20,10,20,14"
            BorderBrush="{DynamicResource OttoBorder}" BorderThickness="0,0,0,2">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5" VerticalAlignment="Bottom">
          <TextBlock Classes="wordmark" Text="Otto" />

          <StackPanel Orientation="Horizontal" Spacing="7">
            <views:StateGlyph Width="13" Height="13" State="{Binding State}"
                              VerticalAlignment="Center" />

            <!-- Envuelve porque este renglón dejó de ser sólo "Listo · Ctrl+Alt+Espacio".
                 Cuando el atajo no se pudo registrar, acá va la explicación completa, y
                 sin esto se cortaba justo en la parte que dice qué hacer al respecto:
                 un aviso que no entra en la pantalla no avisa nada. -->
            <TextBlock Classes="status" Text="{Binding StatusText}" TextWrapping="Wrap"
                       Classes.listening="{Binding IsListening}"
                       Classes.working="{Binding IsWorking}" />
          </StackPanel>

          <!-- El aviso de reinicio vive acá, en el encabezado, y no adentro de la
               tarjeta de configuración: guardar cierra esa tarjeta, así que el aviso
               se escondía justo en el momento en que empezaba a ser cierto. Y el
               encabezado sigue anunciando el atajo viejo — que es el correcto, es el
               que está escuchando — con lo cual sin esta línea el usuario aprieta la
               combinación nueva, no pasa nada, y la interfaz lo desmiente.

               HotkeyChangePending es lo guardado contra lo registrado, así que esto
               se apaga solo apenas Otto arranca de nuevo. No hay que bajarlo a mano,
               y no puede quedar prendido mintiendo. -->
          <TextBlock Text="El atajo nuevo se activa recién en el próximo inicio de Otto."
                     Classes="status" TextWrapping="Wrap"
                     IsVisible="{Binding HotkeyChangePending}" />
        </StackPanel>

        <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Bottom"
                Command="{Binding ToggleSettingsCommand}"
                IsVisible="{Binding !IsProvisioning}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <!-- Dos rieles con perillas: las perillas se rellenan con el fondo para
                 que el riel se corte al pasar por debajo, igual que en el diseño. -->
            <Canvas Width="15" Height="15" VerticalAlignment="Center">
              <Line StartPoint="1.5,4" EndPoint="14.5,4"
                    Stroke="{DynamicResource OttoText}" StrokeThickness="1.6" />
              <Line StartPoint="1.5,11" EndPoint="14.5,11"
                    Stroke="{DynamicResource OttoText}" StrokeThickness="1.6" />
              <Ellipse Canvas.Left="8.5" Canvas.Top="2" Width="4" Height="4"
                       Fill="{DynamicResource OttoCard}"
                       Stroke="{DynamicResource OttoText}" StrokeThickness="1.6" />
              <Ellipse Canvas.Left="3.5" Canvas.Top="9" Width="4" Height="4"
                       Fill="{DynamicResource OttoCard}"
                       Stroke="{DynamicResource OttoText}" StrokeThickness="1.6" />
            </Canvas>
            <TextBlock Text="Ajustes" FontSize="13" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Configuración: se despliega sobre la lista en vez de abrir otra ventana.
         Es una app chica; una ventana más sería una ventana más que administrar. -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="18,14,18,0"
            IsVisible="{Binding IsSettingsOpen}">
      <StackPanel Spacing="12">
        <TextBlock Classes="eyebrow" Text="CONFIGURACIÓN" />

        <!-- Atajo: nunca texto libre. Lo único que puede llegar a Modifiers/VirtualKey es
             una combinación realmente presionada y capturada por MainViewModel.OfferKey —
             ver HotkeyLabels.cs y el manejador de KeyDown en MainWindow.axaml.cs. -->
        <StackPanel Spacing="4">
          <TextBlock Text="Atajo" FontSize="12" Opacity="0.7" />

          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsCapturingHotkey}">
            <TextBlock Text="{Binding HotkeyLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button Grid.Column="1" Content="Cambiar" Command="{Binding StartHotkeyCaptureCommand}" />
          </Grid>

          <StackPanel Spacing="6" IsVisible="{Binding IsCapturingHotkey}">
            <Border Classes="card" Padding="8">
              <TextBlock Text="{Binding HotkeyHint}" TextWrapping="Wrap" />
            </Border>
            <Button Content="Cancelar" HorizontalAlignment="Left" Command="{Binding CancelHotkeyCaptureCommand}" />
          </StackPanel>

        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Idioma" FontSize="12" Opacity="0.7" />
          <TextBox Text="{Binding Language}" />
        </StackPanel>

        <CheckBox Content="Arrancar con Windows" IsChecked="{Binding StartWithWindows}" />
        <CheckBox Content="Mostrar el personaje en pantalla" IsChecked="{Binding ShowCharacter}" />

        <!-- Indented under the switch above and disabled with it, because choosing
             between appearances of something that is not on screen says nothing.
             The options are bound to one enum through a boolean each, so "none"
             and "more than one" are unrepresentable.

             Ordered by how much attention each one asks for, loudest first. -->
        <StackPanel Spacing="4" Margin="26,0,0,0" IsEnabled="{Binding ShowCharacter}">
          <TextBlock Text="Apariencia" FontSize="12" Opacity="0.7" />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <RadioButton GroupName="Apariencia" Content="Personaje"
                         IsChecked="{Binding IsCharacterAppearance}" />
            <RadioButton GroupName="Apariencia" Content="Discreto"
                         IsChecked="{Binding IsDiscreetAppearance}" />
            <RadioButton GroupName="Apariencia" Content="Punto mínimo"
                         IsChecked="{Binding IsMinimalAppearance}" />
          </StackPanel>
        </StackPanel>

        <!-- Apagado de fábrica: Otto promete funcionar sin internet, así que la
             única llamada a la red que existe la pide la persona, no la app. -->
        <CheckBox Content="Avisarme si hay una versión nueva al arrancar"
                  IsChecked="{Binding CheckForUpdates}" />

        <Button Content="Guardar" Classes="primary" HorizontalAlignment="Right"
                Command="{Binding SaveSettingsCommand}" />

        <Separator Margin="0,4" />

        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Text="{Binding Version, StringFormat='Versión {0}'}"
                     FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding UpdateStatus}" Margin="12,0"
                     FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="Buscar actualizaciones"
                  Command="{Binding CheckUpdatesCommand}" />
        </Grid>

        <Separator Margin="0,4" />

        <!-- Desinstalar en dos pasos, y el primero dice exactamente qué desaparece:
             "borrar mis datos" es abstracto, "borrar 340 notas" no. -->
        <StackPanel Spacing="8">
          <Button Content="Borrar todos mis datos" HorizontalAlignment="Left"
                  Command="{Binding ConfirmUninstallCommand}"
                  IsVisible="{Binding !IsConfirmingUninstall}" />

          <StackPanel Spacing="8" IsVisible="{Binding IsConfirmingUninstall}">
            <TextBlock Text="{Binding UninstallWarning}" TextWrapping="Wrap"
                       FontSize="12" Foreground="#E5484A" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Sí, borrar todo" Command="{Binding UninstallCommand}" />
              <Button Content="Cancelar" Command="{Binding CancelUninstallCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Cuerpo: notas y descarga inicial ocupan el mismo lugar y nunca se ven
         juntas — se turnan según IsProvisioning, en vez de vivir en ventanas
         separadas que habría que administrar. -->
    <Grid>

      <DockPanel LastChildFill="True" IsVisible="{Binding !IsProvisioning}">

        <!-- Búsqueda: en su propia franja, del ancho de la ventana y separada de
             la lista por una línea. Filtrar es una acción sobre la lista entera,
             no un elemento más adentro de ella. -->
        <Border DockPanel.Dock="Top" Padding="20,12"
                BorderBrush="{DynamicResource OttoBorder}" BorderThickness="0,0,0,1"
                IsVisible="{Binding !IsSelecting}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox PlaceholderText="Buscar en tus notas" Text="{Binding Search}"
                     Classes.filtering="{Binding IsSearching}" />
            <Button Grid.Column="1" Content="Seleccionar" Margin="8,0,0,0" FontSize="12.5"
                    Command="{Binding StartSelectingCommand}" />
          </Grid>
        </Border>

        <!-- Elegir notas reemplaza al buscador en vez de sumarse abajo: mientras
             estás eligiendo, filtrar la lista cambiaría el conjunto sobre el que
             venís decidiendo, y "Todas" pasaría a significar otra cosa a mitad de
             camino. -->
        <Border DockPanel.Dock="Top" Padding="20,12"
                BorderBrush="{DynamicResource OttoBorder}" BorderThickness="0,0,0,1"
                IsVisible="{Binding IsSelecting}">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="{Binding SelectionLabel}" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost" Content="Todas" FontSize="12.5"
                    Command="{Binding SelectAllCommand}" />
            <Button Grid.Column="2" Content="Cancelar" Margin="8,0,0,0" FontSize="12.5"
                    Command="{Binding CancelSelectingCommand}" />
          </Grid>
        </Border>

        <!-- Las acciones del lote van abajo, lejos del renglón que se toca para
             elegir. El diseño las separa con una regla de 2px, el doble que la del
             buscador: es un borde entre la lista y algo que actúa sobre ella. -->
        <Border DockPanel.Dock="Bottom" Padding="20,12"
                BorderBrush="{DynamicResource OttoBorder}" BorderThickness="0,2,0,0"
                IsVisible="{Binding IsSelecting}">
          <Grid>
            <StackPanel Orientation="Horizontal" Spacing="8"
                        IsVisible="{Binding !IsConfirmingDeleteSelected}">
              <Button Content="Exportar .txt" FontSize="12.5"
                      Command="{Binding ExportSelectedCommand}" CommandParameter="txt"
                      IsEnabled="{Binding HasSelection}" />
              <Button Content="Exportar .md" FontSize="12.5"
                      Command="{Binding ExportSelectedCommand}" CommandParameter="md"
                      IsEnabled="{Binding HasSelection}" />

              <TextBlock Text="{Binding ExportError}" FontSize="12"
                         VerticalAlignment="Center" Margin="4,0,0,0"
                         Foreground="{DynamicResource OttoDanger}"
                         IsVisible="{Binding ExportError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <Button Classes="accent" FontSize="12.5" HorizontalAlignment="Right"
                    Content="{Binding DeleteSelectedLabel}"
                    Command="{Binding ConfirmDeleteSelectedCommand}"
                    IsEnabled="{Binding HasSelection}"
                    IsVisible="{Binding !IsConfirmingDeleteSelected}" />

            <!-- El segundo paso reemplaza al primero en el mismo lugar: el botón
                 que confirma no puede quedar al lado del que abrió la pregunta. -->
            <Grid ColumnDefinitions="*,Auto,Auto"
                  IsVisible="{Binding IsConfirmingDeleteSelected}">
              <TextBlock Text="{Binding DeleteSelectedWarning}" FontSize="12.5"
                         VerticalAlignment="Center" TextWrapping="Wrap"
                         Foreground="{DynamicResource OttoDanger}" />
              <Button Grid.Column="1" Classes="accent" FontSize="12.5" Margin="12,0,0,0"
                      Content="Sí, borrar" Command="{Binding DeleteSelectedCommand}" />
              <Button Grid.Column="2" Content="Cancelar" FontSize="12.5" Margin="8,0,0,0"
                      Command="{Binding CancelDeleteSelectedCommand}" />
            </Grid>
          </Grid>
        </Border>

        <!-- La lista y el vacío se turnan en el mismo lugar. -->
        <Grid>

          <DockPanel LastChildFill="True" IsVisible="{Binding !IsEmpty}">

            <!-- Cuántas encontró la búsqueda. Sin búsqueda no dice nada: contar
                 las notas que tenés no es información, es ruido. -->
            <TextBlock DockPanel.Dock="Top" Classes="count" Text="{Binding ResultCount}"
                       Margin="20,10,20,0" IsVisible="{Binding IsSearching}" />

        <!-- Notas. Sin padding en el ScrollViewer: los renglones van de borde a
             borde y el suyo propio es el que separa el texto del filo. -->
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Notes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NoteViewModel">
                <Border Classes="note" Classes.editing="{Binding IsEditing}"
                        Classes.picked="{Binding IsSelected}">
                  <Grid ColumnDefinitions="Auto,*">

                    <!-- Sin modo selección la casilla no ocupa lugar: IsVisible en
                         falso la saca de la medición, así que la columna Auto queda
                         en cero y el texto arranca en el margen de siempre. -->
                    <Border Grid.Column="0" Classes="tick" Classes.on="{Binding IsSelected}"
                            IsVisible="{Binding IsSelecting}">
                      <Path Data="M 1.5,5 L 4.5,8 L 9.5,1.5" Stroke="White" StrokeThickness="2"
                            StrokeLineCap="Round" StrokeJoin="Round"
                            IsVisible="{Binding IsSelected}" />
                    </Border>

                  <StackPanel Grid.Column="1">

                    <!-- Lectura -->
                    <StackPanel Spacing="6" IsVisible="{Binding !IsEditing}">
                      <Button Classes="note-open" Command="{Binding ActivateCommand}">
                        <StackPanel Spacing="6">

                          <!-- El título va en la cara expandida del diseño, sin
                               FontWeight: la cara ya es ExtraBold y pedirle negrita
                               encima la sintetizaría una segunda vez, igual que en
                               el logotipo. -->
                          <!-- El texto entra por Highlight y no por Text: lo que
                               coincidió con la búsqueda se pinta, y eso pide dos
                               colores dentro de un mismo TextBlock. -->
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="note-title"
                                       Classes.untitled="{Binding !HasTitle}"
                                       TextTrimming="CharacterEllipsis"
                                       views:Highlight.Text="{Binding Heading}"
                                       views:Highlight.Query="{Binding Query}"
                                       views:Highlight.Brush="{DynamicResource OttoHighlight}" />
                            <TextBlock Grid.Column="1" Text="{Binding Subtitle}"
                                       Classes="note-meta" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                          </Grid>

                          <!-- Recortada a cuatro renglones: la lista sirve para
                               encontrar la nota, no para leerla entera. El resto
                               aparece al abrirla. -->
                          <TextBlock Classes="note-body"
                                     TextWrapping="Wrap" MaxLines="4"
                                     TextTrimming="CharacterEllipsis"
                                     views:Highlight.Text="{Binding Text}"
                                     views:Highlight.Query="{Binding Query}"
                                     views:Highlight.Brush="{DynamicResource OttoHighlight}" />
                        </StackPanel>
                      </Button>

                      <!-- Mientras se eligen notas, las acciones de una sola no
                           existen: copiar o eliminar la fila que estás por marcar
                           es lo contrario de lo que viniste a hacer, y el lote ya
                           tiene su propia barra abajo. -->
                      <StackPanel Orientation="Horizontal" Spacing="2"
                                  IsVisible="{Binding !IsSelecting}">
                        <Button Classes="mini quiet" Content="{Binding CopyLabel}"
                                Command="{Binding CopyCommand}" />
                        <Button Classes="mini quiet" Content="Eliminar"
                                Command="{Binding DeleteCommand}" />
                      </StackPanel>
                    </StackPanel>

                    <!-- Edición -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsEditing}">

                      <!-- Escape es la salida sin guardar. El diseño no dibuja un
                           Cancelar, y un botón para descartar al lado de uno para
                           guardar invita al accidente que justamente no se puede
                           deshacer. -->
                      <StackPanel.KeyBindings>
                        <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}" />
                      </StackPanel.KeyBindings>

                      <TextBox Text="{Binding Title}" PlaceholderText="Sin título"
                               FontFamily="{DynamicResource OttoFontDisplay}" FontSize="15" />

                      <TextBlock Text="{Binding Subtitle}" Classes="note-meta" />

                      <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap"
                               FontSize="13" LineHeight="19.5" MinHeight="140" MaxHeight="260" />

                      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                        <Button Classes="mini quiet" Content="{Binding CopyLabel}"
                                Command="{Binding CopyCommand}" />
                        <Button Grid.Column="1" Classes="mini quiet" Content="Eliminar"
                                Command="{Binding DeleteCommand}" />

                        <TextBlock Grid.Column="3" Text="Cambios sin guardar"
                                   FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OttoTextMuted}"
                                   IsVisible="{Binding IsDirty}" />

                        <!-- Presente pero apagado cuando no hay nada que guardar:
                             en edición el botón es parte de la forma del renglón, y
                             hacerlo aparecer y desaparecer movería todo lo demás
                             mientras alguien escribe. -->
                        <Button Grid.Column="4" Classes="mini primary" Content="Guardar"
                                Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" />
                      </Grid>
                    </StackPanel>

                  </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

          </DockPanel>

          <!-- Vacío: centrado en lo que queda de la ventana y alineado a la
               izquierda, no al medio. Es una frase que se lee, no un cartel.

               El botón sólo existe cuando hay una búsqueda que limpiar. Borrar el
               campo a mano tampoco cuesta nada, pero en ese momento es lo único
               que queda por hacer, y la pantalla bien puede decirlo. -->
          <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center"
                      Margin="56,0" Spacing="10">

            <!-- Un vúmetro adentro de un anillo: la misma figura que el estado
                 "escuchando", quieta. Sólo aparece cuando todavía no hay ningún
                 dictado — una búsqueda sin resultados y un atajo que falló no son
                 momentos para invitar a nadie a nada. -->
            <!-- Alineado a la izquierda a mano: un Canvas de ancho fijo no puede
                 estirarse, y sin esto el StackPanel lo centra y queda flotando
                 arriba de un texto que arranca en el margen. -->
            <Canvas Width="40" Height="40" Margin="0,0,0,8" HorizontalAlignment="Left"
                    IsVisible="{Binding HasNoDictationsYet}">
              <Ellipse Canvas.Left="5" Canvas.Top="5" Width="30" Height="30"
                       Stroke="{DynamicResource OttoGlyphQuiet}" StrokeThickness="2.5" />
              <Rectangle Canvas.Left="13" Canvas.Top="16" Width="3" Height="8"
                         Fill="{DynamicResource OttoGlyphQuiet}" />
              <Rectangle Canvas.Left="18.5" Canvas.Top="13" Width="3" Height="14"
                         Fill="{DynamicResource OttoGlyphQuiet}" />
              <Rectangle Canvas.Left="24" Canvas.Top="17" Width="3" Height="6"
                         Fill="{DynamicResource OttoGlyphQuiet}" />
            </Canvas>

            <TextBlock Text="{Binding EmptyHeading}" TextWrapping="Wrap"
                       Classes="empty-heading"
                       Classes.invitation="{Binding HasNoDictationsYet}" />

            <TextBlock Text="{Binding EmptyDetail}" TextWrapping="Wrap"
                       FontSize="14" LineHeight="22.4"
                       Foreground="{DynamicResource OttoTextMuted}"
                       IsVisible="{Binding HasNoDictationsYet}" />

            <Button Classes="ghost accent" Content="Limpiar la búsqueda"
                    HorizontalAlignment="Left" Padding="0,4"
                    Command="{Binding ClearSearchCommand}"
                    IsVisible="{Binding IsSearching}" />
          </StackPanel>

        </Grid>

      </DockPanel>

      <!-- Descarga inicial: el usuario nunca ve las notas hasta que el modelo
           está listo, así que esto reemplaza toda la sección de arriba en vez de
           superponerse. -->
      <Border Classes="card" Margin="18" VerticalAlignment="Center"
              IsVisible="{Binding IsProvisioning}">
        <StackPanel Spacing="12">

          <StackPanel Spacing="8" IsVisible="{Binding !HasProvisioningError}">
            <TextBlock Classes="eyebrow" Text="PREPARANDO OTTO" />
            <TextBlock Text="{Binding ProvisioningText}" FontSize="15" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProvisioningPercent}" />
            <TextBlock Text="{Binding ProvisioningDetail}" FontSize="12" Opacity="0.7" />
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding HasProvisioningError}">
            <TextBlock Classes="eyebrow" Text="PREPARANDO OTTO" />
            <TextBlock Text="{Binding ProvisioningError}" TextWrapping="Wrap"
                       FontSize="13" Foreground="#E5484A" />
            <Button Content="Reintentar" Classes="primary" HorizontalAlignment="Left"
                    Command="{Binding RetryCommand}" />
          </StackPanel>

        </StackPanel>
      </Border>

    </Grid>

  </DockPanel>
</Window>
