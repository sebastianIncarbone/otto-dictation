<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Otto.Core\Otto.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <!--
    net10.0, not net10.0-windows, and deliberately so even though the binary this
    project drives is a Windows executable. Spawning a process and reading a WAV
    header are portable operations; the only Windows-specific thing in the whole
    reading path is where piper.exe comes from, which is a packaging concern.
    Keeping the TFM portable means CA1416 still fires the day somebody reaches for
    a Win32 call in here, which is the entire mechanism holding the boundary.

    No Whisper.net, no ONNX Runtime, no native runtime packages: the engine runs
    out of process. That is what makes this project's tests headless — they need
    neither a GPU nor a voice file on disk.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
