<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- El personaje. Es el único binario que el repositorio acepta: arte
         autoral, estable, y de él salen tanto el overlay como el .ico. Si la
         carpeta no existe, el glob queda vacío y Otto dibuja la cara de
         respaldo. -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Otto.Core\Otto.Core.csproj" />
    <ProjectReference Include="..\Otto.Speech\Otto.Speech.csproj" />
    <ProjectReference Include="..\Otto.Platform.Windows\Otto.Platform.Windows.csproj" />
    <ProjectReference Include="..\Otto.Storage\Otto.Storage.csproj" />
    <ProjectReference Include="..\Otto.PostProcessing\Otto.PostProcessing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Lo genera build\icono.ps1 y no se commitea, por la misma razón que los
      íconos de bandeja se dibujan en código: el repositorio no acumula
      binarios. La condición existe para que `dotnet build` a secas funcione
      sin haber corrido el script — el ícono sólo importa en lo que se
      distribuye, y publicar.ps1 lo genera antes del publish.
    -->
    <ApplicationIcon Condition="Exists('Otto.ico')">Otto.ico</ApplicationIcon>

    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
