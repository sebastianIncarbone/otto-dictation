<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Otto.App.Views"
        x:Class="Otto.App.Views.CharacterWindow"
        Width="96" Height="96"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        IsHitTestVisible="False">

  <views:OttoCharacter x:Name="Character" />
</Window>
