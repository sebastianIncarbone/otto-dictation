<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="NAudio" Version="3.0.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.0.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.AllRuntimes" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- LLamaSharp + LLamaSharp.Backend.Vulkan arrive transitively through this
         reference, same as Otto.App: the corrector lives in one place, and its
         native package refs travel with it instead of being pinned a second
         time here where they could drift out of version lockstep. -->
    <ProjectReference Include="..\..\src\Otto.PostProcessing\Otto.PostProcessing.csproj" />
    <ProjectReference Include="..\..\src\Otto.Speech\Otto.Speech.csproj" />
  </ItemGroup>

</Project>
