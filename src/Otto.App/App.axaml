<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Otto.App.App"
             RequestedThemeVariant="Default">

  <Application.Styles>
    <FluentTheme />

    <!-- After Fluent, so these win. Fluent stays underneath for everything the
         redesign does not speak about — scrollbars, menus, the caret. -->
    <StyleInclude Source="avares://Otto.App/Theme/Controls.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Otto.App/Theme/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
