<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Otto.App.Views.CharacterWindow"
        Width="144" Height="144"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False">

  <!-- Empty on purpose: the overlay is built in code, because which of the two it
       is depends on a setting and swapping it has to detach the outgoing one. -->
  <Panel x:Name="Host" />
</Window>
